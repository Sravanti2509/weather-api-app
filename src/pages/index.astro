<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Weatherly | Live Weather</title>

  <style>
    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      font-family: Inter, Arial, sans-serif;

      background:
        radial-gradient(
          circle at 10% 0%,
          rgba(74, 144, 226, 0.12),
          transparent 28%
        ),
        radial-gradient(
          circle at 90% 15%,
          rgba(91, 134, 229, 0.1),
          transparent 25%
        ),
        #f5f8fc;

      color: #17243a;
    }

    .app {
      min-height: 100vh;
    }

    /* =========================
       NAVBAR
    ========================= */

    .navbar {
      height: 76px;
      padding: 0 7%;

      display: flex;
      align-items: center;
      justify-content: space-between;

      background: rgba(255, 255, 255, 0.9);

      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);

      border-bottom: 1px solid rgba(220, 228, 238, 0.8);

      position: sticky;
      top: 0;

      z-index: 100;

      box-shadow:
        0 4px 25px rgba(31, 56, 88, 0.04);
    }

    .logo {
      font-size: 26px;
      font-weight: 800;

      letter-spacing: -1.2px;

      color: #17243a;
    }

    .logo span {
      color: #4b8ff8;
    }

    .nav-right {
      display: flex;
      align-items: center;

      gap: 12px;

      color: #65748a;

      font-size: 13px;
      font-weight: 600;
    }

    .nav-right span {
      padding: 9px 14px;

      background: #f4f7fb;

      border: 1px solid #e4eaf2;

      border-radius: 999px;
    }


    /* =========================
       HERO
    ========================= */

    .hero {
      text-align: center;

      padding: 92px 20px 55px;
    }

    .hero small {
      display: inline-flex;

      align-items: center;

      padding: 8px 15px;

      background: rgba(75, 143, 248, 0.09);

      border: 1px solid rgba(75, 143, 248, 0.18);

      border-radius: 999px;

      color: #4384e8;

      font-weight: 800;

      letter-spacing: 1.8px;

      text-transform: uppercase;

      font-size: 11px;
    }

    .hero h1 {
      max-width: 950px;

      margin: 22px auto 18px;

      font-size: clamp(45px, 7vw, 78px);

      line-height: 0.98;

      letter-spacing: -4.5px;

      font-weight: 850;

      background:
        linear-gradient(
          135deg,
          #17243a 20%,
          #3f78d5 80%
        );

      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .hero p {
      max-width: 600px;

      margin: 0 auto;

      color: #718096;

      font-size: 17px;

      line-height: 1.75;
    }


    /* =========================
       SEARCH
    ========================= */

    .search-area {
      width: 100%;

      max-width: 920px;

      margin: 0 auto 60px;

      padding: 0 20px;
    }

    .search-box {
      width: 100%;

      display: flex;

      gap: 10px;

      align-items: stretch;
    }

    .search-box input {
      flex: 1;

      min-width: 0;

      height: 60px;

      padding: 0 21px;

      border: 1px solid #dce5ef;

      border-radius: 17px;

      background: rgba(255, 255, 255, 0.95);

      color: #17243a;

      font-size: 15px;

      outline: none;

      box-shadow:
        0 10px 30px rgba(40, 68, 100, 0.06);

      transition: 0.25s ease;
    }

    .search-box input::placeholder {
      color: #9aa7b7;
    }

    .search-box input:focus {
      border-color: #6a9ff2;

      box-shadow:
        0 0 0 4px rgba(75, 143, 248, 0.1),
        0 12px 32px rgba(40, 68, 100, 0.08);
    }

    .search-box button,
    #locationButton {
      height: 60px;

      padding: 0 23px;

      border-radius: 17px;

      font-size: 14px;

      font-weight: 750;

      cursor: pointer;

      white-space: nowrap;

      transition:
        transform 0.2s ease,
        box-shadow 0.2s ease,
        background 0.2s ease;
    }

    .search-box button {
      border: none;

      background:
        linear-gradient(
          135deg,
          #172b4d,
          #31578f
        );

      color: #fff;

      box-shadow:
        0 10px 24px rgba(38, 72, 117, 0.18);
    }

    .search-box button:hover {
      transform: translateY(-2px);

      box-shadow:
        0 14px 30px rgba(38, 72, 117, 0.25);
    }

    #locationButton {
      border: 1px solid #dce5ef;

      background: #fff;

      color: #263a57;

      box-shadow:
        0 8px 22px rgba(40, 68, 100, 0.05);
    }

    #locationButton:hover {
      transform: translateY(-2px);

      background: #f7faff;

      border-color: #bfcfe2;
    }

    #message {
      min-height: 20px;

      margin-top: 15px;

      text-align: center;

      color: #6c7b90;

      font-size: 13px;

      font-weight: 500;
    }


    /* =========================
       CONTENT
    ========================= */

    .content {
      width: 90%;

      max-width: 1080px;

      margin: 0 auto;

      padding-bottom: 90px;
    }


    /* =========================
       CURRENT WEATHER
    ========================= */

    .current-card {
      width: 100%;

      padding: 40px;

      background:
        linear-gradient(
          135deg,
          rgba(255, 255, 255, 0.98),
          rgba(247, 250, 255, 0.96)
        );

      border: 1px solid #dfe7f0;

      border-radius: 30px;

      box-shadow:
        0 25px 65px rgba(34, 58, 88, 0.09);

      position: relative;

      overflow: hidden;
    }

    .current-card::before {
      content: "";

      position: absolute;

      width: 240px;
      height: 240px;

      top: -120px;
      right: -80px;

      background: rgba(77, 145, 247, 0.1);

      border-radius: 50%;
    }

    .current-top {
      display: flex;

      justify-content: space-between;

      align-items: flex-start;

      position: relative;

      z-index: 1;
    }

    .location h2 {
      margin: 0;

      font-size: 32px;

      letter-spacing: -1px;

      font-weight: 800;
    }

    .location p {
      margin: 8px 0 0;

      color: #8a98aa;

      font-size: 14px;
    }

    .weather-icon {
      width: 70px;
      height: 70px;

      display: flex;

      align-items: center;
      justify-content: center;

      font-size: 43px;

      background: #eef5ff;

      border: 1px solid #dbe9fb;

      border-radius: 22px;

      box-shadow:
        0 10px 25px rgba(60, 111, 178, 0.08);
    }

    .temperature-section {
      padding: 40px 0;

      text-align: center;
    }

    .temperature {
      font-size: 88px;

      font-weight: 850;

      letter-spacing: -7px;

      line-height: 1;

      color: #182940;
    }

    .condition {
      margin-top: 15px;

      color: #66778d;

      font-size: 17px;

      text-transform: capitalize;
    }


    /* =========================
       DETAILS
    ========================= */

    .details {
      display: grid;

      grid-template-columns: repeat(4, 1fr);

      gap: 12px;
    }

    .detail {
      min-width: 0;

      padding: 21px 15px;

      background:
        linear-gradient(
          145deg,
          #f8fbff,
          #f2f6fb
        );

      border: 1px solid #e5ebf2;

      border-radius: 17px;

      text-align: center;

      transition: 0.2s ease;
    }

    .detail:hover {
      transform: translateY(-2px);

      border-color: #d3e1f1;

      box-shadow:
        0 8px 22px rgba(44, 75, 111, 0.07);
    }

    .detail .label {
      display: block;

      margin-bottom: 9px;

      color: #8c9aab;

      font-size: 10px;

      font-weight: 700;

      text-transform: uppercase;

      letter-spacing: 0.8px;
    }

    .detail strong {
      font-size: 17px;

      color: #1c2c43;
    }


    /* =========================
       SECTIONS
    ========================= */

    .section {
      width: 100%;

      margin-top: 70px;
    }

    .section-title {
      margin-bottom: 27px;

      text-align: center;
    }

    .section-title h2 {
      margin: 0;

      font-size: 28px;

      letter-spacing: -0.8px;

      font-weight: 800;

      color: #1a2a42;
    }

    .section-title p {
      margin: 9px 0 0;

      color: #8390a1;

      font-size: 13px;
    }


    /* =========================
       HOURLY FORECAST
    ========================= */

    .hourly-container {
      width: 100%;

      max-width: 920px;

      margin: 0 auto;

      padding: 5px 3px 17px;

      display: flex;

      gap: 13px;

      justify-content: center;

      align-items: stretch;

      overflow-x: auto;

      overflow-y: hidden;

      scrollbar-width: thin;

      scrollbar-color:
        #c8d5e5
        transparent;

      -webkit-overflow-scrolling: touch;
    }

    .hourly-container::-webkit-scrollbar {
      height: 6px;
    }

    .hourly-container::-webkit-scrollbar-track {
      background: transparent;
    }

    .hourly-container::-webkit-scrollbar-thumb {
      background: #c8d5e5;

      border-radius: 999px;
    }

    .hourly-container > p {
      width: 100%;

      min-width: 100%;

      margin: 25px 0;

      text-align: center;

      color: #718096;

      font-size: 15px;

      line-height: 1.6;
    }

    .hour {
      min-width: 120px;

      flex: 0 0 120px;

      padding: 21px 15px;

      background: rgba(255, 255, 255, 0.96);

      border: 1px solid #e0e8f1;

      border-radius: 19px;

      text-align: center;

      box-shadow:
        0 9px 26px rgba(35, 63, 94, 0.05);

      transition:
        transform 0.2s ease,
        border-color 0.2s ease,
        box-shadow 0.2s ease;
    }

    .hour:hover {
      transform: translateY(-3px);

      border-color: #cdddf0;

      box-shadow:
        0 14px 30px rgba(35, 63, 94, 0.09);
    }

    .hour span {
      display: block;

      margin-bottom: 15px;

      color: #8290a2;

      font-size: 12px;

      font-weight: 600;
    }

    .hour strong {
      display: block;

      margin-bottom: 13px;

      font-size: 31px;
    }

    .hour b {
      font-size: 18px;

      color: #263b59;
    }


    /* =========================
       5 DAY FORECAST
       IMPORTANT CENTER FIX
    ========================= */

    .forecast-list {
      width: 100%;

      max-width: 1080px;

      margin: 0 auto;

      display: flex;

      flex-direction: row;

      justify-content: center;

      align-items: stretch;

      gap: 14px;

      overflow-x: auto;

      padding: 5px 10px 18px;

      scrollbar-width: thin;

      scrollbar-color:
        #c8d5e5
        transparent;
    }

    .forecast-list::-webkit-scrollbar {
      height: 6px;
    }

    .forecast-list::-webkit-scrollbar-track {
      background: transparent;
    }

    .forecast-list::-webkit-scrollbar-thumb {
      background: #c8d5e5;

      border-radius: 999px;
    }

    /* EACH 5-DAY CARD */

    .forecast-day {
      flex: 0 0 168px;

      width: 168px;

      min-height: 190px;

      padding: 22px 16px;

      display: flex;

      flex-direction: column;

      align-items: center;

      justify-content: center;

      text-align: center;

      background:
        linear-gradient(
          145deg,
          #ffffff,
          #f8fbff
        );

      border: 1px solid #e1e8f0;

      border-radius: 21px;

      box-shadow:
        0 9px 27px rgba(32, 58, 90, 0.055);

      transition:
        transform 0.22s ease,
        border-color 0.22s ease,
        box-shadow 0.22s ease;
    }

    .forecast-day:hover {
      transform: translateY(-5px);

      border-color: #cbdcf0;

      box-shadow:
        0 17px 38px rgba(32, 58, 90, 0.11);
    }

    .day-name {
      text-align: center;
    }

    .day-name strong {
      display: block;

      color: #172a43;

      font-size: 16px;

      font-weight: 800;
    }

    .day-name span {
      display: block;

      margin-top: 5px;

      color: #8997a8;

      font-size: 12px;
    }

    .forecast-icon {
      margin: 20px 0;

      font-size: 38px;

      line-height: 1;
    }

    .forecast-condition {
      color: #68788d;

      font-size: 12px;

      text-transform: capitalize;

      min-height: 18px;
    }

    .forecast-temp {
      margin-top: 14px;

      display: flex;

      align-items: center;

      justify-content: center;

      white-space: nowrap;
    }

    .forecast-temp strong {
      color: #1a2c45;

      font-size: 21px;

      font-weight: 800;
    }

    .forecast-temp span {
      margin-left: 8px;

      color: #929eae;

      font-size: 15px;
    }


    /* =========================
       WEATHER INFO
    ========================= */

    .info-grid {
      display: grid;

      grid-template-columns: repeat(3, 1fr);

      gap: 16px;
    }

    .info-card {
      padding: 27px;

      background: rgba(255, 255, 255, 0.96);

      border: 1px solid #e0e8f0;

      border-radius: 21px;

      box-shadow:
        0 9px 27px rgba(34, 60, 92, 0.045);

      transition:
        transform 0.22s ease,
        border-color 0.22s ease,
        box-shadow 0.22s ease;
    }

    .info-card:hover {
      transform: translateY(-3px);

      border-color: #cfdff1;

      box-shadow:
        0 15px 35px rgba(34, 60, 92, 0.08);
    }

    .info-card .icon {
      width: 48px;
      height: 48px;

      display: flex;

      align-items: center;
      justify-content: center;

      margin-bottom: 18px;

      background: #eff6ff;

      border: 1px solid #dceafb;

      border-radius: 15px;

      font-size: 23px;
    }

    .info-card h3 {
      margin: 0 0 8px;

      font-size: 16px;

      font-weight: 800;

      color: #1c2d45;
    }

    .info-card p {
      margin: 0;

      color: #718095;

      font-size: 13px;

      line-height: 1.6;
    }


    /* =========================
       FOOTER
    ========================= */

    footer {
      padding: 32px 20px;

      background: #ffffff;

      border-top: 1px solid #e4eaf1;

      color: #8b98a8;

      text-align: center;

      font-size: 12px;
    }


    /* =========================
       TABLET
    ========================= */
/* =========================
   TABLET
========================= */

@media (max-width: 1000px) {

  .content {
    width: 92%;
  }

  .forecast-list {
    justify-content: flex-start;
  }

  .details {
    grid-template-columns: repeat(2, 1fr);
  }

  .info-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}


/* =========================
   MOBILE
========================= */
/* =========================================================
   TABLET / MOBILE
========================================================= */

@media (max-width: 1000px) {

  .content {
    width: 92%;
    max-width: 920px;
  }

  .details {
    grid-template-columns: repeat(2, 1fr);
  }

  .info-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .forecast-list {
    justify-content: flex-start;
  }
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 700px) {

  /* =======================================================
     NAVBAR
  ======================================================= */

  .navbar {
    height: 68px;
    padding: 0 18px;
  }

  .logo {
    font-size: 22px;
    white-space: nowrap;
  }

  .nav-right {
    display: none;
  }


  /* =======================================================
     HERO
  ======================================================= */

  .hero {
    padding: 48px 18px 36px;
    text-align: center;
  }

  .hero small {
    display: inline-block;
    font-size: 10px;
    padding: 7px 12px;
    margin-bottom: 12px;
  }

  .hero h1 {
    margin: 0;
    font-size: 39px;
    line-height: 1.08;
    letter-spacing: -2px;
  }

  .hero p {
    max-width: 350px;
    margin: 14px auto 0;
    font-size: 14px;
    line-height: 1.65;
  }


  /* =======================================================
     SEARCH AREA
  ======================================================= */

  .search-area {
    width: 100%;
    padding: 0 16px;
    margin-bottom: 38px;
  }

  .search-box {

    width: 100%;

    display: flex;
    flex-direction: column;

    gap: 11px;

    height: auto;
  }


  /* INPUT */

  .search-box input {

    width: 100% !important;

    height: 58px;

    min-height: 58px;

    padding: 0 18px;

    font-size: 16px;

    border-radius: 16px;

    box-sizing: border-box;
  }


  /* SEARCH BUTTON */

  .search-box button {

    width: 100% !important;

    height: 58px;

    min-height: 58px;

    border-radius: 16px;

    font-size: 15px;

    font-weight: 600;

    box-sizing: border-box;
  }


  /* MY LOCATION BUTTON */

  #locationButton {

    width: 100% !important;

    height: 58px;

    min-height: 58px;

    border-radius: 16px;

    font-size: 15px;

    font-weight: 600;

    box-sizing: border-box;
  }


  /* =======================================================
     MAIN CONTENT
  ======================================================= */

  .content {

    width: calc(100% - 28px);

    max-width: 100%;

    margin: 0 auto;
  }


  /* =======================================================
     CURRENT WEATHER CARD
  ======================================================= */

  .current-card {

    width: 100%;

    padding: 24px 18px;

    border-radius: 22px;

    overflow: hidden;
  }


  /* LOCATION */

  .location h2 {
    font-size: 23px;
    line-height: 1.2;
  }

  .location p {
    margin-top: 5px;
    font-size: 13px;
  }


  /* WEATHER ICON */

  .weather-icon {

    width: 58px;
    height: 58px;

    min-width: 58px;

    font-size: 32px;

    border-radius: 17px;
  }


  /* =======================================================
     TEMPERATURE
  ======================================================= */

  .temperature-section {

    padding: 30px 0 27px;

    text-align: center;
  }

  .temperature {

    font-size: 62px;

    line-height: 1;

    letter-spacing: -4px;
  }

  .condition {

    margin-top: 9px;

    font-size: 15px;
  }


  /* =======================================================
     WEATHER DETAILS
  ======================================================= */

  .details {

    display: grid;

    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: 10px;

    width: 100%;
  }

  .detail {

    min-width: 0;

    padding: 17px 10px;

    border-radius: 16px;

    text-align: center;

    overflow: hidden;
  }

  .detail strong {

    display: block;

    font-size: 14px;

    line-height: 1.3;

    white-space: nowrap;
  }


  /* =======================================================
     SECTION HEADERS
  ======================================================= */

  .section {

    width: 100%;

    margin-top: 48px;
  }

  .section-title {

    margin-bottom: 20px;

    padding: 0 2px;
  }

  .section-title h2 {

    margin: 0;

    font-size: 23px;

    line-height: 1.2;
  }

  .section-title p {

    margin-top: 6px;

    font-size: 12px;

    line-height: 1.5;
  }


  /* =======================================================
     HOURLY FORECAST
  ======================================================= */

  .hourly-container {

    width: 100%;

    margin: 0;

    padding: 4px 2px 18px;

    display: flex;

    flex-direction: row;

    align-items: stretch;

    justify-content: flex-start;

    gap: 11px;

    overflow-x: auto;

    overflow-y: hidden;

    scroll-snap-type: x mandatory;

    scrollbar-width: none;

    -webkit-overflow-scrolling: touch;
  }

  .hourly-container::-webkit-scrollbar {
    display: none;
  }


  /* HOURLY CARD */

  .hour {

    flex: 0 0 116px;

    width: 116px;

    min-width: 116px;

    min-height: 155px;

    padding: 17px 12px;

    border-radius: 18px;

    display: flex;

    flex-direction: column;

    align-items: center;

    justify-content: space-between;

    text-align: center;

    scroll-snap-align: start;

    box-sizing: border-box;
  }


  /* TIME */

  .hour span {

    display: block;

    width: 100%;

    margin: 0 0 10px;

    font-size: 11px;

    line-height: 1.2;

    white-space: nowrap;
  }


  /* TEMPERATURE */

  .hour strong {

    display: block;

    margin: 0 0 10px;

    font-size: 27px;

    line-height: 1;

    white-space: nowrap;
  }


  /* CONDITION / WEATHER */

  .hour b {

    display: block;

    max-width: 100%;

    font-size: 14px;

    line-height: 1.3;

    white-space: nowrap;

    overflow: hidden;

    text-overflow: ellipsis;
  }


  /* =======================================================
     5 DAY FORECAST
  ======================================================= */

  .forecast-list {

    width: 100%;

    max-width: none;

    margin: 0;

    padding: 4px 2px 20px;

    display: flex;

    flex-direction: row;

    align-items: stretch;

    justify-content: flex-start;

    gap: 11px;

    overflow-x: auto;

    overflow-y: hidden;

    scroll-snap-type: x mandatory;

    scrollbar-width: none;

    -webkit-overflow-scrolling: touch;
  }

  .forecast-list::-webkit-scrollbar {
    display: none;
  }


  /* FORECAST CARD */

  .forecast-day {

    flex: 0 0 158px;

    width: 158px;

    min-width: 158px;

    min-height: 195px;

    padding: 18px 13px;

    border-radius: 19px;

    display: flex;

    flex-direction: column;

    align-items: center;

    text-align: center;

    scroll-snap-align: start;

    box-sizing: border-box;
  }


  /* DAY */

  .day-name {

    width: 100%;

    text-align: center;
  }

  .day-name strong {

    display: block;

    font-size: 14px;

    line-height: 1.3;

    white-space: nowrap;
  }

  .day-name span {

    display: block;

    margin-top: 4px;

    font-size: 11px;

    line-height: 1.3;

    white-space: nowrap;
  }


  /* ICON */

  .forecast-icon {

    margin: 18px 0 14px;

    font-size: 34px;

    line-height: 1;

  }


  /* CONDITION */

  .forecast-condition {

    width: 100%;

    min-height: 30px;

    font-size: 11px;

    line-height: 1.4;

    display: flex;

    align-items: center;

    justify-content: center;

    text-align: center;

    overflow: hidden;
  }


  /* TEMPERATURE */

  .forecast-temp {

    width: 100%;

    margin-top: auto;

    padding-top: 12px;

    display: flex;

    align-items: baseline;

    justify-content: center;

    gap: 5px;
  }

  .forecast-temp strong {

    font-size: 18px;

    line-height: 1;

    white-space: nowrap;
  }

  .forecast-temp span {

    margin-left: 0;

    font-size: 13px;

    line-height: 1;

    white-space: nowrap;
  }


  /* =======================================================
     INFO CARDS
  ======================================================= */

  .info-grid {

    display: grid;

    grid-template-columns: 1fr;

    gap: 12px;
  }

  .info-card {

    width: 100%;

    padding: 21px;

    border-radius: 18px;

    box-sizing: border-box;
  }


  /* =======================================================
     FOOTER
  ======================================================= */

  footer {

    padding: 28px 16px;
  }
}


/* =========================================================
   SMALL PHONES
========================================================= */

@media (max-width: 400px) {

  /* NAVBAR */

  .navbar {
    height: 64px;
    padding: 0 14px;
  }

  .logo {
    font-size: 20px;
  }


  /* HERO */

  .hero {
    padding: 40px 14px 30px;
  }

  .hero h1 {

    font-size: 34px;

    line-height: 1.08;

    letter-spacing: -1.7px;
  }

  .hero p {

    max-width: 320px;

    font-size: 13px;

    line-height: 1.6;
  }


  /* SEARCH */

  .search-area {

    padding: 0 13px;

    margin-bottom: 34px;
  }

  .search-box {
    gap: 9px;
  }

  .search-box input {

    height: 56px;

    min-height: 56px;

    font-size: 15px;

    border-radius: 15px;
  }

  .search-box button,
  #locationButton {

    height: 56px;

    min-height: 56px;

    font-size: 14px;

    border-radius: 15px;
  }


  /* CONTENT */

  .content {

    width: calc(100% - 24px);
  }


  /* CURRENT WEATHER */

  .current-card {

    padding: 21px 14px;

    border-radius: 20px;
  }

  .location h2 {
    font-size: 21px;
  }

  .location p {
    font-size: 12px;
  }


  /* TEMPERATURE */

  .temperature {

    font-size: 56px;

    letter-spacing: -3.5px;
  }


  /* DETAILS */

  .details {
    gap: 8px;
  }

  .detail {
    padding: 15px 7px;
  }

  .detail strong {
    font-size: 13px;
  }


  /* SECTION */

  .section {
    margin-top: 43px;
  }

  .section-title h2 {
    font-size: 21px;
  }


  /* HOURLY */

  .hourly-container {

    gap: 9px;

    padding-left: 1px;

    padding-right: 1px;
  }

  .hour {

    flex-basis: 110px;

    width: 110px;

    min-width: 110px;

    min-height: 150px;

    padding: 16px 10px;

    border-radius: 17px;
  }

  .hour strong {
    font-size: 25px;
  }


  /* 5 DAY */

  .forecast-list {

    gap: 9px;

    padding-left: 1px;

    padding-right: 1px;
  }

  .forecast-day {

    flex-basis: 148px;

    width: 148px;

    min-width: 148px;

    min-height: 190px;

    padding: 17px 11px;

    border-radius: 18px;
  }

  .forecast-icon {
    font-size: 32px;
    margin: 17px 0 13px;
  }

  .forecast-temp strong {
    font-size: 17px;
  }

  .forecast-temp span {
    font-size: 12px;
  }


  /* INFO */

  .info-card {
    padding: 19px;
  }


  /* FOOTER */

  footer {
    padding: 25px 14px;
  }
}
  </style>
</head>


<body>

  <div class="app">

    <!-- =========================
         NAVBAR
    ========================= -->

    <nav class="navbar">

      <div class="logo">
        Weather<span>ly</span>
      </div>

      <div class="nav-right">
        <span>Live Weather</span>
        <span>°C</span>
      </div>

    </nav>


    <!-- =========================
         HERO
    ========================= -->

    <section class="hero">

      <small>
        Live Weather
      </small>

      <h1>
        Weather, wherever you are.
      </h1>

      <p>
        Search any city and get accurate current
        weather information instantly.
      </p>

    </section>


    <!-- =========================
         SEARCH
    ========================= -->

    <div class="search-area">

      <div class="search-box">

        <input
          type="text"
          id="city"
          placeholder="Search for a city..."
        />

        <button id="button">
          Search
        </button>

        <button id="locationButton">
          📍 My Location
        </button>

      </div>

      <div id="message"></div>

    </div>


    <!-- =========================
         MAIN
    ========================= -->

    <main class="content">


      <!-- CURRENT WEATHER -->

      <section
        class="current-card"
        id="weatherCard"
        style="display: none;"
      >

        <div class="current-top">

          <div class="location">

            <h2 id="cityName">
              Hyderabad, IN
            </h2>

            <p>
              Current weather
            </p>

          </div>

          <div
            class="weather-icon"
            id="weatherIcon"
          >
            🌤️
          </div>

        </div>


        <div class="temperature-section">

          <div
            class="temperature"
            id="temperature"
          >
            --°C
          </div>

          <div
            class="condition"
            id="condition"
          >
            --
          </div>

        </div>


        <div class="details">

          <div class="detail">
            <span class="label">
              Feels Like
            </span>

            <strong id="feelsLike">
              --
            </strong>
          </div>


          <div class="detail">
            <span class="label">
              Humidity
            </span>

            <strong id="humidity">
              --
            </strong>
          </div>


          <div class="detail">
            <span class="label">
              Wind
            </span>

            <strong id="wind">
              --
            </strong>
          </div>


          <div class="detail">
            <span class="label">
              Pressure
            </span>

            <strong id="pressure">
              --
            </strong>
          </div>


          <div class="detail">
            <span class="label">
              Min Temp
            </span>

            <strong id="minTemp">
              --
            </strong>
          </div>


          <div class="detail">
            <span class="label">
              Max Temp
            </span>

            <strong id="maxTemp">
              --
            </strong>
          </div>


          <div class="detail">
            <span class="label">
              Sunrise
            </span>

            <strong id="sunrise">
              --
            </strong>
          </div>


          <div class="detail">
            <span class="label">
              Sunset
            </span>

            <strong id="sunset">
              --
            </strong>
          </div>

        </div>

      </section>


      <!-- =========================
           HOURLY FORECAST
      ========================= -->

      <section class="section">

        <div class="section-title">

          <h2>
            Hourly Forecast
          </h2>

          <p>
            Weather conditions for the next few hours.
          </p>

        </div>


        <div
          class="hourly-container"
          id="hourlyContainer"
        >

          <p>
            Search a city to view forecast.
          </p>

        </div>

      </section>


      <!-- =========================
           5 DAY FORECAST
      ========================= -->

      <section class="section">

        <div class="section-title">

          <h2>
            5-Day Forecast
          </h2>

          <p>
            A quick look at the weather for the coming days.
          </p>

        </div>


        <!--
          IMPORTANT:
          JS will insert exactly 5 cards here.
          Desktop = centered.
          Mobile = horizontal scroll.
        -->

        <div
          class="forecast-list"
          id="forecastList"
        >

          <p style="text-align: center; width: 100%;">
            Search a city to view forecast.
          </p>

        </div>

      </section>


      <!-- =========================
           WEATHER DETAILS
      ========================= -->

      <section class="section">

        <div class="section-title">

          <h2>
            Weather Details
          </h2>

          <p>
            More information about current conditions.
          </p>

        </div>


        <div class="info-grid">


          <div class="info-card">

            <div class="icon">
              👁️
            </div>

            <h3>
              Visibility
            </h3>

            <p id="visibility">
              Search a city to view
            </p>

          </div>


          <div class="info-card">

            <div class="icon">
              ☁️
            </div>

            <h3>
              Cloud Cover
            </h3>

            <p id="clouds">
              Search a city to view
            </p>

          </div>


          <div class="info-card">

            <div class="icon">
              🌧️
            </div>

            <h3>
              Rain
            </h3>

            <p id="rain">
              Search a city to view
            </p>

          </div>


        </div>

      </section>

    </main>


    <!-- =========================
         FOOTER
    ========================= -->

    <footer>
      Weatherly · Live weather powered by OpenWeather
    </footer>

  </div>


  <!-- =========================
       JAVASCRIPT
  ========================= -->

  <script>

    /* =========================
       ELEMENTS
    ========================= */

    const button =
      document.querySelector("#button");

    const locationButton =
      document.querySelector("#locationButton");

    const cityInput =
      document.querySelector("#city");

    const message =
      document.querySelector("#message");

    const weatherCard =
      document.querySelector("#weatherCard");

    const cityName =
      document.querySelector("#cityName");

    const temperature =
      document.querySelector("#temperature");

    const condition =
      document.querySelector("#condition");

    const weatherIcon =
      document.querySelector("#weatherIcon");

    const feelsLike =
      document.querySelector("#feelsLike");

    const humidity =
      document.querySelector("#humidity");

    const wind =
      document.querySelector("#wind");

    const pressure =
      document.querySelector("#pressure");

    const minTemp =
      document.querySelector("#minTemp");

    const maxTemp =
      document.querySelector("#maxTemp");

    const sunrise =
      document.querySelector("#sunrise");

    const sunset =
      document.querySelector("#sunset");

    const visibility =
      document.querySelector("#visibility");

    const clouds =
      document.querySelector("#clouds");

    const rain =
      document.querySelector("#rain");

    const hourlyContainer =
      document.querySelector("#hourlyContainer");

    const forecastList =
      document.querySelector("#forecastList");


    /* =========================
       API KEY
    ========================= */

	const apiKey = "9858d0b9e00986f7c6e5a8248a04c000";

    console.log(
      "OpenWeather API key loaded:",
      Boolean(apiKey)
    );


    /* =========================
       WEATHER ICON
    ========================= */

    function getWeatherIcon(weather) {

      if (weather === "Rain") {
        return "🌧️";
      }

      if (weather === "Clouds") {
        return "☁️";
      }

      if (weather === "Clear") {
        return "☀️";
      }

      if (weather === "Snow") {
        return "❄️";
      }

      if (weather === "Thunderstorm") {
        return "⛈️";
      }

      if (weather === "Drizzle") {
        return "🌦️";
      }

      if (
        weather === "Mist" ||
        weather === "Fog" ||
        weather === "Haze"
      ) {
        return "🌫️";
      }

      return "🌤️";
    }


    /* =========================
       TIME FORMAT
    ========================= */

    function formatTime(timestamp) {

      return new Date(
        timestamp * 1000
      ).toLocaleTimeString(
        [],
        {
          hour: "2-digit",
          minute: "2-digit"
        }
      );

    }


    /* =========================
       DISPLAY CURRENT WEATHER
    ========================= */

    function displayWeather(data) {

      cityName.textContent =
        `${data.name}, ${data.sys.country}`;

      temperature.textContent =
        `${Math.round(data.main.temp)}°C`;

      condition.textContent =
        data.weather[0].description;

      weatherIcon.textContent =
        getWeatherIcon(
          data.weather[0].main
        );

      feelsLike.textContent =
        `${Math.round(data.main.feels_like)}°C`;

      humidity.textContent =
        `${data.main.humidity}%`;

      wind.textContent =
        `${data.wind.speed} m/s`;

      pressure.textContent =
        `${data.main.pressure} hPa`;

      minTemp.textContent =
        `${Math.round(data.main.temp_min)}°C`;

      maxTemp.textContent =
        `${Math.round(data.main.temp_max)}°C`;

      sunrise.textContent =
        formatTime(data.sys.sunrise);

      sunset.textContent =
        formatTime(data.sys.sunset);

      visibility.textContent =
        `${(data.visibility / 1000).toFixed(1)} km`;

      clouds.textContent =
        `${data.clouds.all}%`;

      if (
        data.rain &&
        data.rain["1h"] !== undefined
      ) {

        rain.textContent =
          `${data.rain["1h"]} mm`;

      } else {

        rain.textContent =
          "No rain";

      }

      weatherCard.style.display =
        "block";
    }


    /* =========================
       SEARCH CITY
    ========================= */

    async function searchCity(city) {

      if (!apiKey) {

        message.textContent =
          "API key is missing. Please check your .env file.";

        return;
      }

      message.textContent =
        "Loading weather...";

      weatherCard.style.display =
        "none";

      try {

        const response =
          await fetch(
            `https://api.openweathermap.org/data/2.5/weather?q=${encodeURIComponent(city)}&appid=${apiKey}&units=metric`
          );

        const data =
          await response.json();

        if (!response.ok) {

          throw new Error(
            data.message ||
            "Unable to get weather."
          );

        }

        displayWeather(data);

        await loadForecast(city);

        message.textContent = "";

      } catch (error) {

        console.error(
          "Weather error:",
          error
        );

        weatherCard.style.display =
          "none";

        const errorMessage =
          error.message.toLowerCase();

        if (
          errorMessage.includes(
            "invalid api key"
          )
        ) {

          message.textContent =
            "Invalid API key. Please check your OpenWeather API key.";

        } else if (
          errorMessage.includes(
            "city not found"
          )
        ) {

          message.textContent =
            "City not found. Please check the city name.";

        } else {

          message.textContent =
            error.message ||
            "Something went wrong.";

        }
      }
    }


    /* =========================
       SEARCH BUTTON
    ========================= */

    button.addEventListener(
      "click",
      () => {

        const city =
          cityInput.value.trim();

        if (!city) {

          message.textContent =
            "Please enter a city name.";

          weatherCard.style.display =
            "none";

          return;
        }

        searchCity(city);
      }
    );


    /* =========================
       ENTER KEY
    ========================= */

    cityInput.addEventListener(
      "keydown",
      (event) => {

        if (
          event.key === "Enter"
        ) {

          button.click();

        }

      }
    );


    /* =========================
       LOAD FORECAST
    ========================= */

    async function loadForecast(city) {

      try {

        const response =
          await fetch(
            `https://api.openweathermap.org/data/2.5/forecast?q=${encodeURIComponent(city)}&appid=${apiKey}&units=metric`
          );

        const data =
          await response.json();

        if (!response.ok) {

          throw new Error(
            data.message ||
            "Forecast unavailable."
          );

        }

        createHourlyForecast(
          data.list
        );

        createFiveDayForecast(
          data.list
        );

      } catch (error) {

        console.error(
          "Forecast error:",
          error
        );

        showForecastError();
      }
    }


    /* =========================
       FORECAST ERROR
    ========================= */

    function showForecastError() {

      hourlyContainer.innerHTML = `
        <div class="hour">

          <span>
            Forecast
          </span>

          <strong>
            —
          </strong>

          <b>
            Unavailable
          </b>

        </div>
      `;

      forecastList.innerHTML = `
        <div class="forecast-day">

          <div class="day-name">

            <strong>
              Forecast unavailable
            </strong>

            <span>
              Please try again later
            </span>

          </div>

        </div>
      `;
    }


    /* =========================
       HOURLY FORECAST
    ========================= */

    function createHourlyForecast(list) {

      hourlyContainer.innerHTML = "";

      const nextHours =
        list.slice(0, 6);

      nextHours.forEach(
        (item, index) => {

          const date =
            new Date(
              item.dt * 1000
            );

          const time =
            index === 0
              ? "Now"
              : date.toLocaleTimeString(
                  [],
                  {
                    hour: "numeric",
                    minute: "2-digit"
                  }
                );

          const icon =
            getWeatherIcon(
              item.weather[0].main
            );

          const card =
            document.createElement("div");

          card.className =
            "hour";

          card.innerHTML = `
            <span>
              ${time}
            </span>

            <strong>
              ${icon}
            </strong>

            <b>
              ${Math.round(item.main.temp)}°
            </b>
          `;

          hourlyContainer.appendChild(
            card
          );
        }
      );
    }


    /* =========================
       FIVE DAY FORECAST
    ========================= */

    function createFiveDayForecast(list) {

      forecastList.innerHTML = "";

      const days = {};

      list.forEach(
        (item) => {

          const date =
            new Date(
              item.dt * 1000
            );

          const key =
            date.toLocaleDateString(
              "en-CA"
            );

          if (!days[key]) {
            days[key] = [];
          }

          days[key].push(item);
        }
      );


      /*
        Take maximum 5 days.
      */

      const dayKeys =
        Object.keys(days).slice(0, 5);


      dayKeys.forEach(
        (key, index) => {

          const items =
            days[key];


          /*
            Prefer afternoon weather
          */

          const midday =
            items.find(
              (item) => {

                const hour =
                  new Date(
                    item.dt * 1000
                  ).getHours();

                return (
                  hour >= 12 &&
                  hour <= 15
                );

              }
            ) || items[0];


          const date =
            new Date(
              midday.dt * 1000
            );


          const dayName =
            index === 0
              ? "Today"
              : index === 1
              ? "Tomorrow"
              : date.toLocaleDateString(
                  [],
                  {
                    weekday: "long"
                  }
                );


          const dateText =
            date.toLocaleDateString(
              [],
              {
                month: "short",
                day: "numeric"
              }
            );


          const icon =
            getWeatherIcon(
              midday.weather[0].main
            );


          const high =
            Math.max(
              ...items.map(
                item =>
                  item.main.temp_max
              )
            );


          const low =
            Math.min(
              ...items.map(
                item =>
                  item.main.temp_min
              )
            );


          const card =
            document.createElement("div");

          card.className =
            "forecast-day";


          card.innerHTML = `

            <div class="day-name">

              <strong>
                ${dayName}
              </strong>

              <span>
                ${dateText}
              </span>

            </div>


            <div class="forecast-icon">
              ${icon}
            </div>


            <div class="forecast-condition">
              ${midday.weather[0].description}
            </div>


            <div class="forecast-temp">

              <strong>
                ${Math.round(high)}°
              </strong>

              <span>
                ${Math.round(low)}°
              </span>

            </div>

          `;


          forecastList.appendChild(
            card
          );

        }
      );
    }


    /* =========================
       MY LOCATION
    ========================= */

    locationButton.addEventListener(
      "click",
      () => {

        if (!apiKey) {

          message.textContent =
            "API key is missing. Please check your .env file.";

          return;
        }


        if (
          !navigator.geolocation
        ) {

          message.textContent =
            "Location is not supported by your browser.";

          return;
        }


        message.textContent =
          "Getting your location...";


        weatherCard.style.display =
          "none";


        navigator.geolocation.getCurrentPosition(

          async (position) => {

            const lat =
              position.coords.latitude;

            const lon =
              position.coords.longitude;


            try {

              const response =
                await fetch(
                  `https://api.openweathermap.org/data/2.5/weather?lat=${lat}&lon=${lon}&appid=${apiKey}&units=metric`
                );


              const data =
                await response.json();


              if (!response.ok) {

                throw new Error(
                  data.message ||
                  "Unable to get weather."
                );

              }


              displayWeather(data);


              await loadForecastByCoordinates(
                lat,
                lon
              );


              message.textContent = "";


            } catch (error) {

              console.error(
                "Location weather error:",
                error
              );

              message.textContent =
                error.message ||
                "Unable to get weather for your location.";

            }

          },


          (error) => {

            console.error(
              "Geolocation error:",
              error
            );


            if (
              error.code === 1
            ) {

              message.textContent =
                "Please allow location access.";

            } else if (
              error.code === 2
            ) {

              message.textContent =
                "Unable to detect your location.";

            } else if (
              error.code === 3
            ) {

              message.textContent =
                "Location request timed out.";

            } else {

              message.textContent =
                "Unable to get your location.";

            }

          },


          {
            enableHighAccuracy: true,

            timeout: 10000,

            maximumAge: 300000
          }

        );
      }
    );


    /* =========================
       FORECAST BY COORDINATES
    ========================= */

    async function loadForecastByCoordinates(
      lat,
      lon
    ) {

      try {

        const response =
          await fetch(
            `https://api.openweathermap.org/data/2.5/forecast?lat=${lat}&lon=${lon}&appid=${apiKey}&units=metric`
          );


        const data =
          await response.json();


        if (!response.ok) {

          throw new Error(
            data.message ||
            "Forecast unavailable."
          );

        }


        createHourlyForecast(
          data.list
        );


        createFiveDayForecast(
          data.list
        );


      } catch (error) {

        console.error(
          "Location forecast error:",
          error
        );

        showForecastError();

      }
    }

  </script>

</body>

</html>